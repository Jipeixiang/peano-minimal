  "cards": [
    {
      "dot": "amber",
      "title": "生成的文件分两处",
      "items": [
        "build/（第 0 步）留在仓库里，所有模拟共用。",
        "code/、raw_data/、data/ 只属于这一次模拟设置，写到 $GAUGE_WAVE_WORK_DIR。",
        "不设这个变量时，这三个目录就出现在 example/ 里，结构相同。"
      ]
    },
    {
      "dot": "emerald",
      "title": "按网格分开",
      "items": [
        "raw_data/ 和 data/ 每种网格一个目录：n9/、n27/、n81/，互不覆盖。",
        "code/ 三种网格共用，只剩最后一次生成的程序。"
      ]
    },
    {
      "dot": "slate",
      "title": "回到跑之前",
      "items": [
        "rm -rf \"$GAUGE_WAVE_WORK_DIR\"，再在 peano-minimal 里 rm -rf build。"
      ]
    }
  ]
