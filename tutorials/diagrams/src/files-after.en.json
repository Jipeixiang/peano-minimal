  "cards": [
    {
      "dot": "amber",
      "title": "Generated files in two places",
      "items": [
        "build/ (step 0) stays in the repository and is shared by every simulation.",
        "code/, raw_data/ and data/ belong to this one set-up and go to $GAUGE_WAVE_WORK_DIR.",
        "Without the variable these three folders appear inside example/, with the same structure."
      ]
    },
    {
      "dot": "emerald",
      "title": "One folder per grid",
      "items": [
        "raw_data/ and data/ have one folder per grid: n9/, n27/, n81/, so runs never overwrite each other.",
        "code/ is shared by all grids and keeps only the last generated program."
      ]
    },
    {
      "dot": "slate",
      "title": "Back to before the runs",
      "items": [
        "rm -rf \"$GAUGE_WAVE_WORK_DIR\", then rm -rf build inside peano-minimal."
      ]
    }
  ]
